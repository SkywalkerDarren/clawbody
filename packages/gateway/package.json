{
  "name": "@clawbody/gateway",
  "version": "1.0.0",
  "description": "ClawBody 网关服务 - gRPC/HTTP/WS/SSE 服务端、路由、mDNS 发现",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@clawbody/core": "workspace:*",
    "@clawbody/live2d": "workspace:*",
    "@clawbody/proto-gen": "workspace:*",
    "@clawbody/speaker-verification": "workspace:*",
    "@clawbody/stt": "workspace:*",
    "@clawbody/tts": "workspace:*",
    "@clawbody/vad": "workspace:*",
    "@clawbody/vision": "workspace:*",
    "@grpc/grpc-js": "^1.12.0",
    "bonjour-service": "^1.3.0",
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": ["dist", "public"]
}
