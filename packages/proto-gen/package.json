{
  "name": "@clawbody/proto-gen",
  "version": "1.0.0",
  "description": "ClawBody Protobuf 生成代码",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "proto:gen": "grpc_tools_node_protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=outputServices=grpc-js --ts_proto_opt=esModuleInterop=true -I ../../proto ../../proto/*.proto",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "grpc-tools": "^1.12.4",
    "ts-proto": "^2.6.0",
    "typescript": "^5.7.0"
  },
  "files": ["dist"]
}
